# Secrets — never commit
.env
.env.*
*.key
*api_key*
*secrets*

# Dependencies (the generator script is dependency-free; this is just safety)
node_modules/

# OS noise
.DS_Store
Thumbs.db

# Editor noise
.vscode/
.idea/
*.swp
*.swo
*~

# Build / temp
dist/
tmp/
*.log

# Validator artifact — regenerated on every run (read it, don't commit it)
rag/landmark_validation_report.json

# Cloudflare Workers (Step 2) — auto-generated
.wrangler/
.dev.vars
.cd

# Eval artifact — regenerated on every run
rag/eval_gemini_report.json

# transient "most recent run" duplicate — the per-model eval_critic_<model>.json files are the durable record
rag/eval_critic_report.json
rag/runs/*.json

# Local scratch: patch scripts, moved-aside files, commit message drafts.
# device_bash cannot delete on this machine, so files are MOVED here instead of removed.
_to_delete/
